rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{path=**}/favorites/{favoriteId} {
      allow read: if true;
      allow write: if false; 
    }

    // Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Checking custom claims set by the Firebase Admin SDK to avoid extra document reads
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    // Users may only self-assign buyer/seller, may only move sellerStatus to 'pending',
    // and cannot raise their own listing limit or verification flags.
    function isSafeSelfProfile(d) {
      return (!('role' in d) || d.role in ['buyer', 'seller']) &&
             (!('accountType' in d) || d.accountType in ['buyer', 'seller']) &&
             (!('sellerStatus' in d) || d.sellerStatus == 'pending' ||
               (resource != null && resource.data.get('sellerStatus', null) == d.sellerStatus)) &&
             (!('listingLimit' in d) || d.listingLimit <= 40 ||
               (resource != null && resource.data.get('listingLimit', null) == d.listingLimit)) &&
             (!('isVerified' in d) || (resource != null && resource.data.get('isVerified', null) == d.isVerified));
    }

    function isValidProduct(productData) {
      return productData.price >= 0 &&
             productData.price <= 100000 &&
             productData.title.size() > 0 &&
             productData.title.size() <= 200 &&
             productData.imageUrls.size() >= 1 &&
             productData.imageUrls.size() <= 10;
    }

    // Users
    match /users/{userId} {
      // Public can read seller profiles only (seller page / product pages read sellerId docs).
      // Buyer profiles are private to owner + admins.
      allow get, list: if isOwner(userId) || isAdmin() || (resource != null && (resource.data.accountType == 'seller' || resource.data.role == 'seller'));
      allow create: if isOwner(userId) && isSafeSelfProfile(request.resource.data);
      allow update: if isAdmin() || (isOwner(userId) && isSafeSelfProfile(request.resource.data));
      // Only superadmins should be able to delete user accounts permanently
      allow delete: if isAdmin();
      
      // Allow users to manage their favorite categories
      match /favorite_categories/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Allow users to manage their favorite products
      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Saved searches: owner can read/delete; create/update via server actions (limits + sanitising).
      match /saved_searches/{searchId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }
    }

    // Products
    match /products/{productId} {
      allow read: if resource.data.status == 'available' || 
                  (isAuthenticated() && resource.data.sellerId == request.auth.uid) || 
                  isAdmin();
      
      allow create: if isAuthenticated() && 
                     request.resource.data.sellerId == request.auth.uid &&
                     isValidProduct(request.resource.data);
      
      allow update: if isAuthenticated() && 
                     (resource.data.sellerId == request.auth.uid || isAdmin()) &&
                     (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId'])) &&
                     isValidProduct(request.resource.data);

      // Explicitly DENY permanent delete through client SDK for safety.
      // All deletions must be "soft deletes" performed via update.
      allow delete: if false;
    }

    // Ads - Public Read, Admin Write
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews should be created via server action to verify order completion and prevent spam
      allow create: if false; 
      allow update, delete: if isAdmin();
    }
    
    // Wanted Listings (WTB)
    match /wanted_listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Explicitly DENY permanent delete through client SDK for safety.
      // All deletions must be "soft deletes" performed via update.
      allow delete: if false;
    }
    
    // Bids
    match /bids/{bidId} {
       allow read: if isAuthenticated() && (resource.data.bidderId == request.auth.uid || isAdmin());
       allow create: if isAuthenticated() && request.resource.data.bidderId == request.auth.uid;
       allow update: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Notifications must ALWAYS be created via Server Actions / Admin SDK
      allow create: if false; 
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // Settings & Site Config
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)) || isAdmin();
      // Orders must ALWAYS be created via createOrderAction server action for calculation integrity
      allow create: if false;
      allow update: if isAdmin();
    }

    // Activity Logs - System only
    match /activity_logs/{logId} {
      allow read, write: if false;
    }
    
    // Guest enquiries: created only via server action (Admin SDK).
    // Sellers read enquiries for their own listings; admins read all.
    match /guest_enquiries/{enquiryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Card Imports for SamCam
    match /card_imports/{importId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Coin Imports for CoinCam
    match /coin_imports/{importId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Shoe Imports for ShoeCam
    match /shoe_imports/{importId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Conversations and Messages
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
  }
}
